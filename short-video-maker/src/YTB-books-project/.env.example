# YTB-Books-Project 환경변수
# 이 파일을 .env로 복사하고 값을 채워주세요

# ===== Neo4j 연결 (필수) =====

# 현재 설정: GCP VM Self-hosted (34.47.112.49)
NEO4J_URI=bolt://34.47.112.49:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=ytbbooks2026
NEO4J_DATABASE=neo4j

# AuraDB 사용 시 (대안)
# NEO4J_URI=neo4j+s://xxxxx.databases.neo4j.io
# NEO4J_USERNAME=neo4j
# NEO4J_PASSWORD=your-password-here
# NEO4J_DATABASE=neo4j

# ===== LLM 설정 (최소 1개 필수) =====

# Gemini (권장 - 무료 티어 있음)
# Google AI Studio: https://aistudio.google.com/
LLM_MODEL_CONFIG_gemini_2_0_flash=gemini-2.0-flash

# OpenAI (유료)
# LLM_MODEL_CONFIG_openai_gpt_4o=gpt-4o,sk-xxxxx

# Anthropic (유료)
# LLM_MODEL_CONFIG_anthropic_claude_3_5_sonnet=claude-3-5-sonnet-20241022,sk-ant-xxxxx

# ===== Embedding 설정 (선택) =====
# 기본값: all-MiniLM-L6-v2 (무료, 로컬)
# 옵션: openai, vertexai
EMBEDDING_MODEL=

# ===== GCP 설정 (선택) =====
PROJECT_ID=dkdk-474008
BUCKET_UPLOAD_FILE=
